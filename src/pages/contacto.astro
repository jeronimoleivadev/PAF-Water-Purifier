---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto | PAF-Water-Purifier" description="Ponte en contacto con PAF-Water-Purifier en Catamarca para cotizar el alquiler de tu dispenser de agua.">
  <div class="py-16 px-4 max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-brand-dark mb-4">Hablemos de tu próximo Dispenser</h1>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        Completá el formulario y te contactamos a la brevedad, o si preferís, escribinos directamente por WhatsApp.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 bg-white p-8 md:p-12 rounded-2xl shadow-xl border border-gray-100">
      
      <!-- COLUMNA IZQUIERDA: Información de Contacto -->
      <div class="space-y-8">
        <div>
          <h3 class="text-2xl font-bold text-brand-dark mb-6">Información de Contacto</h3>
          <p class="text-gray-600 mb-6">Estamos en Catamarca y listos para asesorarte. Elegí el medio que te resulte más cómodo.</p>
        </div>

        <div class="flex items-start space-x-4">
          <div class="bg-brand-light p-3 rounded-full text-brand-blue">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <div>
            <h4 class="font-semibold text-brand-dark">Ubicación</h4>
            <p class="text-gray-600 text-sm">San Fernando del Valle de Catamarca<br/>Atendemos en toda la ciudad y alrededores.</p>
          </div>
        </div>

        <div class="flex items-start space-x-4">
          <div class="bg-brand-light p-3 rounded-full text-brand-blue">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <div>
            <h4 class="font-semibold text-brand-dark">Correo Electrónico</h4>
            <p class="text-gray-600 text-sm">pafwaterpurifier2026@gmail.com<br/>(Respondemos en menos de 24hs hábiles)</p>
          </div>
        </div>
      </div>

      <!-- COLUMNA DERECHA: Formulario (Formspree) -->
      <div class="bg-gray-50 p-6 md:p-8 rounded-xl border border-gray-200">
        <!-- IMPORTANTE: Reemplaza "TU_ID_AQUI" por tu ID de Formspree -->
        <form action="https://formspree.io/f/xgakeyqq" method="POST" class="space-y-5">
          
          <div>
            <label for="nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre completo</label>
            <input type="text" name="nombre" id="nombre" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-brand-blue focus:border-brand-blue outline-none transition-colors bg-white" placeholder="Ej: Juan Pérez">
          </div>

          <div>
            <label for="telefono" class="block text-sm font-medium text-gray-700 mb-1">Teléfono / WhatsApp</label>
            <input type="tel" name="telefono" id="telefono" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-brand-blue focus:border-brand-blue outline-none transition-colors bg-white" placeholder="Ej: 383 4123456">
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico</label>
            <input type="email" name="email" id="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-brand-blue focus:border-brand-blue outline-none transition-colors bg-white" placeholder="tu@email.com">
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-medium text-gray-700 mb-1">¿Qué modelo te interesa?</label>
            <textarea name="mensaje" id="mensaje" rows="4" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-brand-blue focus:border-brand-blue outline-none transition-colors bg-white" placeholder="Contanos si lo querés para tu casa, oficina, o qué dudas tenés..."></textarea>
          </div>

          <!-- Campo trampa para detener SPAM (no lo borres) -->
          <input type="text" name="_gotcha" style="display:none" />

          <button type="submit" class="w-full bg-brand-blue hover:bg-brand-dark text-white font-semibold py-3 rounded-lg transition-colors shadow-md">
            Enviar Mensaje
          </button>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>